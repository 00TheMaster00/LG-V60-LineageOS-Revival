From 175901fa8aa5614cc50a695cdaa783a1bbfbba41 Mon Sep 17 00:00:00 2001
From: The1-Master <315181980+The1-Master@users.noreply.github.com>
Date: Sun, 2 Aug 2026 06:48:21 +0500
Subject: [PATCH 1/8] V60 performance v1

---
 kernel/sched/core_ctl.c          | 2 +-
 kernel/sched/cpufreq_schedutil.c | 4 ++--
 localversion-v60perf1            | 1 +
 3 files changed, 4 insertions(+), 3 deletions(-)
 create mode 100644 localversion-v60perf1

diff --git a/kernel/sched/core_ctl.c b/kernel/sched/core_ctl.c
index dc65337d2dbf..3ef5b034e903 100644
--- a/kernel/sched/core_ctl.c
+++ b/kernel/sched/core_ctl.c
@@ -1293,7 +1293,7 @@ static int cluster_init(const struct cpumask *mask)
 		return -EINVAL;
 	}
 	cluster->first_cpu = first_cpu;
-	cluster->min_cpus = 1;
+	cluster->min_cpus = cluster->num_cpus;
 	cluster->max_cpus = cluster->num_cpus;
 	cluster->need_cpus = cluster->num_cpus;
 	cluster->offline_delay_ms = 100;
diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
index e010804bcc79..4f525473e484 100644
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
@@ -1291,8 +1291,8 @@ static int sugov_init(struct cpufreq_policy *policy)
 		goto stop_kthread;
 	}
 
-	tunables->up_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
-	tunables->down_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
+	tunables->up_rate_limit_us = 0;
+	tunables->down_rate_limit_us = 10000;
 	tunables->hispeed_load = DEFAULT_HISPEED_LOAD;
 	tunables->hispeed_freq = 0;
 
diff --git a/localversion-v60perf1 b/localversion-v60perf1
new file mode 100644
index 000000000000..6831c5f8efa4
--- /dev/null
+++ b/localversion-v60perf1
@@ -0,0 +1 @@
+-v60perf1
-- 
2.43.0
